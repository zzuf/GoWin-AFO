{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-windows-api.local/schema/abi-oracle-manifest-v1.json",
  "title": "Windows ABI oracle probe manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "sdkVersion", "profile", "architecture", "includes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": { "$ref": "#/$defs/nonEmpty" },
    "sdkVersion": { "$ref": "#/$defs/nonEmpty" },
    "profile": { "$ref": "#/$defs/nonEmpty" },
    "architecture": { "enum": ["386", "amd64", "arm64", "arm64ec"] },
    "defines": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "includes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_+./-]+$" }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "values": { "type": "array", "items": { "$ref": "#/$defs/value" } },
    "guids": { "type": "array", "items": { "$ref": "#/$defs/guid" } },
    "bitFields": { "type": "array", "items": { "$ref": "#/$defs/bitField" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } },
    "vtables": { "type": "array", "items": { "$ref": "#/$defs/vtable" } },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$" },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nativeName"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nativeName": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nativeName", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nativeName": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["struct", "union"] },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nativeName", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nativeName": { "$ref": "#/$defs/nonEmpty" },
        "expression": { "$ref": "#/$defs/nonEmpty" },
        "unsigned": { "type": "boolean" }
      }
    },
    "guid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nativeName", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nativeName": { "$ref": "#/$defs/nonEmpty" },
        "expression": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "bitField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nativeName", "record", "field"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nativeName": { "$ref": "#/$defs/nonEmpty" },
        "record": { "$ref": "#/$defs/nonEmpty" },
        "field": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nativeName", "expression", "expectedType", "callingConvention"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nativeName": { "$ref": "#/$defs/nonEmpty" },
        "expression": { "$ref": "#/$defs/nonEmpty" },
        "expectedType": { "$ref": "#/$defs/nonEmpty" },
        "callingConvention": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "vtable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interface", "vtableType", "method"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "interface": { "$ref": "#/$defs/nonEmpty" },
        "vtableType": { "$ref": "#/$defs/nonEmpty" },
        "method": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nativeName", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nativeName": { "$ref": "#/$defs/nonEmpty" },
        "expression": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
